# Required
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-random-passphrase
# 4-64 chars: letters, digits, - or _ (not "health", "static", "about", "blog" or "icons"). Your dashboard lives at BASE_URL/<ADMIN_PATH>/
ADMIN_PATH=zeus
# Public URL of the site, no trailing slash. https:// turns on Secure cookies and HSTS.
BASE_URL=https://chat.example.com

# Optional
PORT=8080
# How many reverse proxies sit in front of the app (Render, Fly and Railway: 1). Used to read the real client IP
# for rate limiting. Set 0 if the app is exposed directly to the internet.
TRUSTED_PROXY_HOPS=1
# Maximum database connections the app opens (1-20, default 6). Small hosted databases run out of memory
# when too many connections are open, so keep this low on free plans.
DB_MAX_CONNS=6
# Web Push (optional). Leave both empty and a key pair is made on first start and kept in the database.
# To manage the keys yourself, set both. Changing them later stops existing notification subscriptions until people turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https:// address. Defaults to BASE_URL.
VAPID_SUBJECT=
# Extra push hosts to accept, comma separated (exact name, or a leading dot for a whole domain). Browser push services are built in.
PUSH_ALLOWED_HOSTS=
# Older setting. Sessions are stored in the database; this only signs dashboard form tokens.
SESSION_SECRET=
