# Required
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-random-passphrase
# 8-64 chars: letters, digits, - or _. Your dashboard lives at BASE_URL/<ADMIN_PATH>/
ADMIN_PATH=my-private-admin-x7k2q9
# Public URL of the site, no trailing slash. https:// turns on Secure cookies.
BASE_URL=https://chat.example.com

# Optional
PORT=8080
# Signs session cookies. If empty, it is derived from ADMIN_PASSWORD + DATABASE_URL.
SESSION_SECRET=
